<view wx:if="{{show}}" class="mask" bindtap="onMaskTap">
  <view class="picker-panel" catchtap="stopPropagation">
    <view class="picker-head">
      <text class="picker-cancel" bindtap="onCancel">取消</text>
      <text class="picker-title">选择周</text>
      <text class="picker-ok" bindtap="onConfirm">确定</text>
    </view>
    <view class="picker-body">
      <picker-view class="pv" value="{{tempPickerValue}}" bindchange="onPickerChange">
        <picker-view-column>
          <view wx:for="{{years}}" wx:key="*this" class="pi">{{item}}年</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{weeks}}" wx:key="*this" class="pi">第{{item}}周</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>
</view>
