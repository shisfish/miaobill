.fab {
  position: fixed;
  left: 50%;
  bottom: 32rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  box-shadow: 0 4rpx 16rpx rgba(255, 213, 79, 0.4);
}

.fab-icon {
  font-size: 56rpx;
  color: #000000;
  font-weight: 300;
}

.fab:active {
  transform: scale(0.95);
  transition: transform 0.1s;
}