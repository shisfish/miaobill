.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.amount-section {
  background-color: white;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}

.currency {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.amount {
  font-size: 72rpx;
  font-weight: bold;
  color: #333;
}

.type-switch {
  display: flex;
  background-color: white;
  padding: 0 32rpx 32rpx;
  gap: 32rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s ease;
}

.type-item.active {
  color: #4CAF50;
  font-weight: bold;
  border-bottom-color: #4CAF50;
}

.category-section {
  background-color: white;
  flex: 1;
  max-height: 400rpx;
}

.category-scroll {
  height: 100%;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 20rpx 16rpx;
  gap: 20rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.category-item.active {
  background-color: #f0f9f0;
}

.category-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.category-item.active .category-icon-wrapper {
  background-color: #4CAF50;
}

.category-icon {
  font-size: 48rpx;
  transition: all 0.3s ease;
}

.category-item.active .category-icon {
  filter: brightness(0) invert(1);
}

.category-name {
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.category-item.active .category-name {
  color: #4CAF50;
  font-weight: bold;
}

.info-section {
  background-color: white;
  margin: 20rpx 32rpx;
  border-radius: 16rpx;
  padding: 0 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.info-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #999;
  margin-right: 8rpx;
}

.picker-value {
  text-align: right;
  font-size: 28rpx;
  color: #333;
  margin-right: 8rpx;
}

.info-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.info-divider {
  height: 1rpx;
  background-color: #f0f0f0;
}

.keyboard {
  background-color: #e0e0e0;
  padding: 2rpx;
}

.keyboard-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rpx;
}

.key {
  background-color: white;
  padding: 40rpx 0;
  text-align: center;
  font-size: 40rpx;
  font-weight: 500;
  color: #333;
  transition: all 0.1s ease;
}

.key:active {
  background-color: #f0f0f0;
}

.key.delete {
  font-size: 36rpx;
}

.key.save {
  background-color: #4CAF50;
  color: white;
  font-weight: bold;
  grid-row: span 2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.key.save:active {
  background-color: #45a049;
}

.key.empty {
  background-color: #f5f5f5;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: white;
  border-radius: 16rpx;
  width: 560rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 40rpx 32rpx;
}

.modal-input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  padding: 32rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.modal-btn.cancel {
  color: #999;
  border-right: 1rpx solid #f0f0f0;
}

.modal-btn.confirm {
  color: #4CAF50;
  font-weight: bold;
}