<view class="container {{keyboardVisible ? 'no-scroll' : ''}}">
  <!-- 黄色顶部导航 -->
  <view class="top-bar">
    <view class="tab-switch">
      <text class="tab-item {{type===2?'active':''}}" bindtap="switchType" data-type="2">支出</text>
      <text class="tab-item {{type===1?'active':''}}" bindtap="switchType" data-type="1">收入</text>
    </view>
    <text class="cancel-btn" bindtap="goBack">取消</text>
  </view>

  <!-- 分类网格 -->
  <scroll-view scroll-y="{{!keyboardVisible}}" class="cat-scroll" enhanced show-scrollbar="{{false}}">
    <view class="cat-grid">
      <block wx:for="{{categories}}" wx:key="name">
        <view class="cat-item" bindtap="selectCategory" data-category="{{item.name}}">
          <view class="cat-icon-wrap {{selectedCategory===item.name ? 'sel' : ''}}">
            <text class="cat-icon-text">{{item.icon}}</text>
          </view>
          <text class="cat-name">{{item.name}}</text>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- 键盘弹层（默认隐藏） -->
  <view class="kb-overlay {{keyboardVisible ? 'show' : ''}}" catchtap="hideKeyboard">
    <view class="kb-panel" catchtap stopPropagation>

      <!-- 金额行（右上角） -->
      <view class="kb-amount-row">
        <text class="amt-val-big">{{amount || '0.00'}}</text>
      </view>

      <!-- 备注输入行 -->
      <view class="kb-header">
        <view class="remark-box">
          <text class="remark-label">备注:</text>
          <input
            class="remark-input"
            placeholder="点击填写备注"
            placeholder-class="remark-placeholder"
            value="{{remark}}"
            bindinput="onRemarkInput"
            maxlength="30"
          />
        </view>
      </view>

      <!-- 数字键盘 -->
      <view class="kb">
        <view class="kb-row">
          <text class="k k-num" bindtap="pressKey" data-key="7">7</text>
          <text class="k k-num" bindtap="pressKey" data-key="8">8</text>
          <text class="k k-num" bindtap="pressKey" data-key="9">9</text>
          <!-- 右侧日期按钮 -->
          <view class="k date-btn" bindtap="pickDate">
            <text class="date-icon">📅</text>
            <text>今天</text>
          </view>
        </view>
        <view class="kb-row">
          <text class="k k-num" bindtap="pressKey" data-key="4">4</text>
          <text class="k k-num" bindtap="pressKey" data-key="5">5</text>
          <text class="k k-num" bindtap="pressKey" data-key="6">6</text>
          <text class="k k-num" bindtap="pressKey" data-key="+">+</text>
        </view>
        <view class="kb-row">
          <text class="k k-num" bindtap="pressKey" data-key="1">1</text>
          <text class="k k-num" bindtap="pressKey" data-key="2">2</text>
          <text class="k k-num" bindtap="pressKey" data-key="3">3</text>
          <text class="k k-num" bindtap="pressKey" data-key="-">-</text>
        </view>
        <view class="kb-row">
          <text class="k k-num" bindtap="pressKey" data-key=".">.</text>
          <text class="k k-num" bindtap="pressKey" data-key="0">0</text>
          <view class="k k-action" bindtap="delKey">
            <view class="backspace-icon"></view>
          </view>
          <text class="k k-ok" bindtap="saveRecord">完成</text>
        </view>
      </view>
    </view>
  </view>
</view>