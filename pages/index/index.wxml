<view class="page">
  <view class="top-section">
    <view class="period-tabs">
      <view class="period-tab {{period==='week'?'active':''}}" bindtap="switchPeriod" data-p="week">周</view>
      <view class="period-tab {{period==='month'?'active':''}}" bindtap="switchPeriod" data-p="month">月</view>
      <view class="period-tab {{period==='year'?'active':''}}" bindtap="switchPeriod" data-p="year">年</view>
    </view>

    <view class="date-selector">
      <view class="nav-btn" bindtap="navigatePrev">
        <text class="nav-arrow">◀</text>
      </view>
      <view class="date-display" bindtap="showPeriodPicker">
        <text class="date-text">{{displayDate}}</text>
        <text class="date-arrow">▼</text>
      </view>
      <view class="nav-btn" bindtap="navigateNext">
        <text class="nav-arrow">▶</text>
      </view>
    </view>
  </view>

  <view class="hero-card">
    <view class="hero-top">
      <view>
        <text class="hero-kicker">{{periodText}}</text>
        <view class="hero-title-row">
          <text class="hero-title">支出</text>
        </view>
      </view>
    </view>

    <view class="amount-row">
      <text class="amount-prefix">¥</text>
      <text class="amount-value">{{totalExpense || '0.00'}}</text>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">趋势图</text>
      <text class="section-subtitle">{{period==='week'?'近 7 天支出':period==='month'?'本月每日支出':'本年每月支出'}}</text>
    </view>
    <scroll-view scroll-x="true" class="trend-scroll" wx:if="{{trendList.length > 10}}">
      <view class="trend-chart-scrollable" style="width: {{trendChartWidth}}rpx;">
        <block wx:for="{{trendList}}" wx:key="label">
          <view class="trend-col-scroll">
            <view class="trend-bar-wrap">
              <view class="trend-bar" style="height: {{item.heightPercent}}%;"></view>
            </view>
            <text class="trend-value">{{item.value}}</text>
            <text class="trend-label">{{item.label}}</text>
          </view>
        </block>
      </view>
    </scroll-view>
    <view class="trend-chart" wx:else>
      <block wx:for="{{trendList}}" wx:key="label">
        <view class="trend-col">
          <view class="trend-bar-wrap">
            <view class="trend-bar" style="height: {{item.heightPercent}}%;"></view>
          </view>
          <text class="trend-value">{{item.value}}</text>
          <text class="trend-label">{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">支出排行</text>
      <text class="section-subtitle">按分类汇总</text>
    </view>
    <view class="rank-list">
      <block wx:for="{{rankList}}" wx:key="name">
        <view class="rank-item">
          <view class="rank-left">
            <view class="rank-icon"><text>{{item.icon}}</text></view>
            <view class="rank-namebox">
              <text class="rank-name">{{item.name}}</text>
              <text class="rank-pct">{{item.pct}}</text>
            </view>
          </view>
          <view class="rank-mid">
            <view class="progress-track">
              <view class="progress-fill" style="width:{{item.barWidth}}%"></view>
            </view>
          </view>
          <text class="rank-amt">¥{{item.amount}}</text>
        </view>
      </block>
      <view wx:if="{{rankList.length===0}}" class="empty-state">暂无数据</view>
    </view>
  </view>



  <view class="bottom-spacer"></view>

  <floating-action-button bind:tap="addRecord" />

  <week-picker
    wx:if="{{period === 'week'}}"
    show="{{showPicker}}"
    value="{{selectedDate}}"
    bind:confirm="onWeekConfirm"
    bind:cancel="onPickerCancel"
  />

  <month-picker
    wx:if="{{period === 'month'}}"
    show="{{showPicker}}"
    value="{{selectedMonth}}"
    bind:confirm="onMonthConfirm"
    bind:cancel="onPickerCancel"
  />

  <year-picker
    wx:if="{{period === 'year'}}"
    show="{{showPicker}}"
    value="{{selectedMonth}}"
    bind:confirm="onYearConfirm"
    bind:cancel="onPickerCancel"
  />

  <!-- 登录确认弹窗 -->
  <login-confirm 
    show="{{showLoginConfirm}}" 
    bind:chooseavatar="onChooseAvatar" 
    bind:cancel="onLoginCancel"
  />
</view>