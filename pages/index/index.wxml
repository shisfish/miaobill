<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <text class="nav-title">图表</text>
  </view>
  
  <!-- 年/月切换 -->
  <view class="toggle-btn">
    <text 
      class="toggle-btn-item {{viewMode === 'month' ? 'active' : ''}}" 
      bindtap="switchViewMode"
      data-mode="month"
    >
      月账单
    </text>
    <text 
      class="toggle-btn-item {{viewMode === 'year' ? 'active' : ''}}" 
      bindtap="switchViewMode"
      data-mode="year"
    >
      年账单
    </text>
  </view>
  
  <!-- 日期选择 -->
  <view class="date-selector">
    <view class="date-arrow" bindtap="prevPeriod">
      <text>‹</text>
    </view>
    <picker 
      mode="{{viewMode === 'month' ? 'month' : 'year'}}" 
      value="{{currentDate}}" 
      start="2020-01" 
      end="2030-12"
      bindchange="onDateChange"
    >
      <view class="date-text">{{displayDate}}</view>
    </picker>
    <view class="date-arrow" bindtap="nextPeriod">
      <text>›</text>
    </view>
  </view>
  
  <!-- 收支统计卡片 -->
  <view class="stat-card">
    <view class="stat-summary">
      <text class="stat-label">总支出</text>
      <text class="stat-amount expense">-¥{{totalExpense}}</text>
    </view>
    <view class="stat-summary">
      <text class="stat-label">总收入</text>
      <text class="stat-amount income">+¥{{totalIncome}}</text>
    </view>
    <view class="stat-summary">
      <text class="stat-label">结余</text>
      <text class="stat-amount {{balance >= 0 ? 'income' : 'expense'}}">
        {{balance >= 0 ? '+' : ''}}¥{{Math.abs(balance)}}
      </text>
    </view>
  </view>
  
  <!-- 支出分类 -->
  <view class="card">
    <view class="card-header">
      <text class="subtitle">支出分类</text>
    </view>
    <view class="category-list">
      <block wx:for="{{expenseCategories}}" wx:key="name">
        <view class="category-item">
          <view class="category-left">
            <view class="category-icon-bg">
              <text class="category-icon">{{item.icon}}</text>
            </view>
            <view class="category-info">
              <text class="category-name">{{item.name}}</text>
              <view class="category-bar-bg">
                <view class="category-bar" style="width: {{item.percentage}}%"></view>
              </view>
            </view>
          </view>
          <view class="category-right">
            <text class="category-amount">-¥{{item.amount}}</text>
            <text class="category-percent">{{item.percentage}}%</text>
          </view>
        </view>
      </block>
    </view>
  </view>
  
  <!-- 收入分类 -->
  <view class="card">
    <view class="card-header">
      <text class="subtitle">收入分类</text>
    </view>
    <view class="category-list">
      <block wx:for="{{incomeCategories}}" wx:key="name">
        <view class="category-item">
          <view class="category-left">
            <view class="category-icon-bg income-bg">
              <text class="category-icon">{{item.icon}}</text>
            </view>
            <view class="category-info">
              <text class="category-name">{{item.name}}</text>
              <view class="category-bar-bg">
                <view class="category-bar income-bar" style="width: {{item.percentage}}%"></view>
              </view>
            </view>
          </view>
          <view class="category-right">
            <text class="category-amount income">+¥{{item.amount}}</text>
            <text class="category-percent">{{item.percentage}}%</text>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>