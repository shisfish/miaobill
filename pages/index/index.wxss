.container {
  padding: 16px;
  padding-bottom: 100px;
}

/* 收支概览样式 */
.overview {
  display: flex;
  justify-content: space-between;
}

.overview-item {
  flex: 1;
  text-align: center;
}

.overview-label {
  display: block;
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.overview-amount {
  font-size: 16px;
  font-weight: 600;
}

.overview-amount text {
  margin: 0 4px;
}

/* 卡片头部样式 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

/* 交易记录列表样式 */
.record-list {
  margin-top: 8px;
}

.record-info {
  flex: 1;
}

.record-category {
  display: flex;
  align-items: center;
  margin-bottom: 4px;
}

.record-icon {
  font-size: 20px;
  margin-right: 8px;
}

.record-name {
  font-size: 14px;
  color: #333;
}

.record-date {
  font-size: 12px;
  color: #999;
}

.empty-record {
  padding: 40px 0;
  text-align: center;
}

/* 底部记账按钮 */
.add-btn {
  position: fixed;
  bottom: 70px;
  right: 20px;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background-color: #1E88E5;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  font-size: 24px;
  z-index: 999;
}