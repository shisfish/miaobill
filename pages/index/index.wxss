.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

.toggle-btn {
  display: flex;
  background-color: #f0f0f0;
  margin: 20rpx 32rpx;
  border-radius: 12rpx;
  padding: 4rpx;
  gap: 4rpx;
}

.toggle-btn-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
  background-color: transparent;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.toggle-btn-item.active {
  background-color: #4CAF50;
  color: white;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.3);
}

.date-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 32rpx 24rpx;
}

.date-arrow {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
  flex-shrink: 0;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.date-arrow:active {
  background-color: #f0f0f0;
  color: #4CAF50;
}

.date-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding: 20rpx 48rpx;
  background-color: white;
  border-radius: 12rpx;
  min-width: 220rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-card {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin: 20rpx 32rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.25);
}

.stat-summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  flex: 1;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 400;
}

.stat-amount {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
  color: #fff;
}

.stat-amount.income {
  color: #fff;
}

.stat-amount.expense {
  color: #fff;
}

.card {
  margin: 20rpx 32rpx;
  background-color: white;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  margin-bottom: 28rpx;
}

.subtitle {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  position: relative;
  padding-left: 20rpx;
}

.subtitle::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #4CAF50, #81C784);
  border-radius: 3rpx;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.category-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.category-icon-bg {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.category-icon-bg.income-bg {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
}

.category-icon {
  font-size: 40rpx;
}

.category-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.category-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.category-bar-bg {
  width: 100%;
  height: 8rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.category-bar {
  height: 100%;
  background-color: #FF9800;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.category-bar.income-bar {
  background-color: #4CAF50;
}

.category-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.category-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.category-amount.income {
  color: #4CAF50;
}

.category-percent {
  font-size: 22rpx;
  color: #999;
}

.empty-category {
  padding: 60rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-category::before {
  content: '📊';
  font-size: 64rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #bbb;
}