page {
  background: #f3f5f8;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff7df 0%, #f3f5f8 22%, #f3f5f8 100%);
  display: flex;
  flex-direction: column;
}

.top-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.date-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 16rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 14rpx 40rpx rgba(34, 40, 49, 0.08);
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f4f6f9;
}

.nav-arrow {
  font-size: 24rpx;
  color: #8b93a5;
}

.date-display {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.date-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.date-arrow {
  font-size: 20rpx;
  color: #8b93a5;
}

.hero-card,
.section-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 40rpx rgba(34, 40, 49, 0.08);
}

.hero-card {
  background: linear-gradient(135deg, #ffcf4a 0%, #ffe7a7 100%);
  color: #1f1f1f;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-kicker {
  display: block;
  font-size: 24rpx;
  color: rgba(31, 31, 31, 0.72);
  letter-spacing: 2rpx;
}

.hero-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
}

.hero-arrow {
  font-size: 24rpx;
  color: rgba(31, 31, 31, 0.7);
}

.hero-badge {
  padding: 10rpx 18rpx;
  background: rgba(255, 255, 255, 0.45);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.amount-row {
  display: flex;
  align-items: flex-end;
  margin-top: 30rpx;
}

.amount-prefix {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.amount-value {
  font-size: 76rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.42);
}

.meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-right {
  align-items: flex-end;
  text-align: right;
}

.meta-label {
  font-size: 22rpx;
  color: rgba(31, 31, 31, 0.68);
}

.meta-value {
  font-size: 30rpx;
  font-weight: 800;
}

.meta-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(31, 31, 31, 0.12);
}

.period-tabs {
  display: flex;
  margin-top: 28rpx;
  padding: 6rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.3);
}

.period-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(31, 31, 31, 0.6);
}

.period-tab.active {
  background: #1f1f1f;
  color: #fff;
  border: none;
  outline: none;
}

.section-card {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f1f1f;
}

.section-subtitle {
  font-size: 22rpx;
  color: #8b93a5;
}

.week-scroll {
  white-space: nowrap;
}

.week-list {
  display: flex;
  gap: 18rpx;
}

.week-item {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #667085;
  background: #f4f6f9;
}

.week-item.active {
  background: #1f1f1f;
  color: #fff;
}

.trend-scroll {
  width: 100%;
}

.trend-chart-scrollable {
  display: flex;
  align-items: flex-end;
  height: 260rpx;
  padding: 0 12rpx;
}

.trend-col-scroll {
  flex-shrink: 0;
  width: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 260rpx;
  padding: 0 12rpx;
}

.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 80rpx;
}

.trend-bar-wrap {
  width: 60%;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: linear-gradient(180deg, rgba(255, 207, 74, 0.12), rgba(255, 207, 74, 0));
  border-radius: 12rpx;
}

.trend-bar {
  width: 36rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(180deg, #ffb703 0%, #f77f00 100%);
  min-height: 8rpx;
  transition: height 0.3s ease;
}

.trend-value {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #1f1f1f;
}

.trend-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8b93a5;
}

.rank-list,
.recent-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rank-item,
.recent-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.rank-left {
  width: 220rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.rank-icon,
.recent-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff7df;
  font-size: 30rpx;
  flex-shrink: 0;
}

.rank-namebox,
.recent-body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.rank-name,
.recent-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.rank-pct,
.recent-subtitle {
  font-size: 22rpx;
  color: #8b93a5;
}

.rank-mid {
  flex: 1;
}

.progress-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: #eff2f6;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ffd166 0%, #fca311 100%);
}

.rank-amt,
.recent-amt {
  width: 150rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f1f1f;
  flex-shrink: 0;
}

.empty-state {
  padding: 56rpx 0 24rpx;
  text-align: center;
  color: #98a2b3;
  font-size: 24rpx;
}

.bottom-spacer {
  height: 220rpx;
}
