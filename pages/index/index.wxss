/* ========== 图表/统计页 ========== */
.container {
  background-color: #F5F5F5;
  min-height: 100vh;
}

/* ---- 黄色头部 ---- */
.header {
  background-color: #FFD54F;
  padding: 24rpx 32rpx;
}
.header-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222222;
}
.arrow-down { font-size: 22rpx; color: #666; }

.period-tabs {
  display: flex;
  background-color: rgba(255,255,255,0.3);
  border-radius: 12rpx;
  padding: 4rpx;
}

.p-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #666666;
  border-radius: 8rpx;
  transition: all .15s ease;
}
.p-tab.active {
  background-color: #333333;
  color: #FFFFFF;
}

/* ---- 周切换 ---- */
.week-bar {
  background-color: #EEEEEE;
  padding: 16rpx 24rpx;
}
.wscroll { white-space: nowrap; }
.witem {
  display: inline-block;
  font-size: 28rpx;
  color: #888888;
  margin-right: 40rpx;
  font-weight: 500;
}
.witem.active {
  color: #222222;
  font-weight: 700;
}
.witem-nav { float:right; font-size:26rpx; color:#888; }

/* ---- 统计摘要 ---- */
.summary {
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #E8E8E8;
}
.sum-item { display: flex; align-items: baseline; }
.sum-lbl { font-size: 26rpx; color: #888; }
.sum-val { font-size: 30rpx; font-weight: 700; color: #222; }
.sub-val { font-size: 26rpx; color: #888; }
.total-right { font-size: 28rpx; color: #222; font-weight: 500; margin-left: auto; }

/* ---- 折线图 ---- */
.chart-area {
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
}
.chart-canvas {
  width: 100%;
  height: 320rpx;
}
.chart-placeholder {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---- 排行榜 ---- */
.rank-section {
  padding: 24rpx 32rpx;
}
.rank-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222222;
  display: block;
  margin-bottom: 20rpx;
}
.rank-list { }
.rank-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}
.ri-left {
  width: 180rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.ri-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-left: 16rpx;
}
.ri-pct {
  font-size: 24rpx;
  color: #888888;
  margin-left: 8rpx;
}
.ri-mid {
  flex: 1;
  padding: 0 16rpx;
}
.ri-amt {
  width: 120rpx;
  text-align: right;
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  flex-shrink: 0;
}