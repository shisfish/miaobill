.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

.toggle-btn {
  display: flex;
  background-color: white;
  margin: 20rpx 32rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.toggle-btn-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
  background-color: white;
  display: flex;
  align-items: center;
  justify-content: center;
}

.toggle-btn-item.active {
  background-color: #4CAF50;
  color: white;
  font-weight: bold;
}

.date-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 0 32rpx 20rpx;
  height: 80rpx;
}

.date-arrow {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #4CAF50;
  font-weight: bold;
  flex-shrink: 0;
  margin: 0 16rpx;
}

.date-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  padding: 16rpx 32rpx;
  background-color: white;
  border-radius: 8rpx;
  min-width: 200rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-card {
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 20rpx 32rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
  height: 160rpx;
}

.stat-summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 1;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.stat-amount {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  white-space: nowrap;
}

.card {
  margin: 20rpx 32rpx;
  background-color: white;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  margin-bottom: 24rpx;
}

.subtitle {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.category-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.category-icon-bg {
  width: 80rpx;
  height: 80rpx;
  background-color: #fff3e0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.category-icon-bg.income-bg {
  background-color: #e8f5e9;
}

.category-icon {
  font-size: 40rpx;
}

.category-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.category-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.category-bar-bg {
  width: 100%;
  height: 8rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.category-bar {
  height: 100%;
  background-color: #FF9800;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.category-bar.income-bar {
  background-color: #4CAF50;
}

.category-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.category-amount {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.category-percent {
  font-size: 22rpx;
  color: #999;
}

.empty-category {
  padding: 40rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}