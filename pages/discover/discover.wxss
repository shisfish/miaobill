.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

.nav-bar {
  height: 88rpx;
  background-color: #4CAF50;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.search-bar {
  margin: 20rpx;
  padding: 20rpx;
  background-color: white;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: #999;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999;
}

.carousel {
  margin: 0 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #4CAF50, #45a049);
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.carousel-text {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
  text-align: center;
}

.section {
  margin: 20rpx;
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #4CAF50;
}

.article-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.article-item {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.article-item:last-child {
  border-bottom: none;
}

.article-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.article-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  line-height: 40rpx;
}

.article-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 32rpx;
}

.article-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.article-author {
  font-size: 22rpx;
  color: #999;
}

.article-views {
  font-size: 22rpx;
  color: #999;
}

.article-image {
  width: 120rpx;
  height: 120rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.image-placeholder {
  font-size: 48rpx;
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
}

.tool-icon {
  width: 80rpx;
  height: 80rpx;
  background-color: #f0f9f0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.tool-text {
  font-size: 24rpx;
  color: #333;
  text-align: center;
}

.topic-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.topic-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.topic-item:last-child {
  border-bottom: none;
}

.topic-tag {
  font-size: 24rpx;
  color: #4CAF50;
  font-weight: bold;
  flex-shrink: 0;
}

.topic-title {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 36rpx;
}

.topic-count {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}

@media (max-width: 375px) {
  .article-title {
    font-size: 26rpx;
  }
  
  .article-desc {
    font-size: 22rpx;
  }
  
  .tool-icon {
    width: 70rpx;
    height: 70rpx;
    font-size: 36rpx;
  }
  
  .tool-text {
    font-size: 22rpx;
  }
}