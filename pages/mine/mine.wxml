<view class="container">
  <!-- 黄色用户区 -->
  <view class="user-header">
    <view class="user-row">
      <button class="avatar-wrap" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" wx:if="{{!isLogin}}">
        <view class="avatar-circle">
          <text class="avatar-char">+</text>
        </view>
      </button>
      <view class="avatar-wrap" wx:else>
        <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
      </view>
      <text class="nickname">{{isLogin ? nickName : '点击登录'}}</text>
      <view class="checkin-btn" bindtap="checkin">
        <text class="ci-icon">📅</text><text>打卡</text>
      </view>
    </view>

    <!-- 统计数字 -->
    <view class="stat-row">
      <view class="st-item">
        <text class="st-val">{{checkinDays}}</text>
        <text class="st-lbl">已连续打卡</text>
      </view>
      <view class="st-item">
        <text class="st-val">{{totalDays}}</text>
        <text class="st-lbl">记账总天数</text>
      </view>
      <view class="st-item">
        <text class="st-val">{{totalRecords}}</text>
        <text class="st-lbl">记账总笔数</text>
      </view>
    </view>
  </view>

  <!-- 升级VIP -->
  <view class="vip-card" bindtap="upgradeVip">
    <view class="vip-left">
      <text class="vip-icon">👑</text>
      <view class="vip-info">
        <text class="vip-title">升级为VIP</text>
        <text class="vip-desc">畅享更多高级功能</text>
      </view>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 功能网格 -->
  <view class="fn-grid">
    <view class="fn-item" bindtap="goMsg">
      <text class="fn-icon">🔔</text><text class="fn-text">消息</text>
    </view>
    <view class="fn-item" bindtap="goBadge">
      <text class="fn-icon">🏅</text><text class="fn-text">我的徽章</text>
    </view>
    <view class="fn-item" bindtap="goPoints">
      <text class="fn-icon">🎁</text><text class="fn-text">我的积分</text>
    </view>
    <view class="fn-item" bindtap="goSettings">
      <text class="fn-icon">⚙️</text><text class="fn-text">设置</text>
      <dot class="red-dot"></dot>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-list">
    <view class="mi" bindtap="goBooks"><text class="mi-icon">📒</text><text>我的账本</text><text class="arr">›</text></view>
    <div class="mi-divider"></div>
    <view class="mi" bindtap="goFamily"><text class="mi-icon">🏠</text><text>家庭账单</text><text class="arr">›</text></view>
  </view>

  <view class="menu-list">
    <view class="mi" bindtap="goSettings2"><text class="mi-icon">⚙️</text><text>设置</text><text class="arr">›</text></view>
    <div class="mi-divider"></div>
    <view class="mi" bindtap="goSecurity"><text class="mi-icon">🛡️</text><text>账户安全中心</text><text class="risk">中风险</text><text class="arr">›</text></view>
  </view>

  <view class="menu-list">
    <view class="mi" bindtap="goFeedback"><text class="mi-icon">✏️</text><text>意见反馈</text><text class="arr">›</text></view>
    <div class="mi-divider"></div>
    <view class="mi" bindtap="goRate"><text class="mi-icon">👍</text><text>去应用市场给杪记评分</text><text class="arr">›</text></view>
    <div class="mi-divider"></div>
    <view class="mi" bindtap="goAbout"><text class="mi-icon">¥</text><text>关于杪记 V1.0.0</text><text class="arr">›</text></view>
  </view>

  <view style="height:200rpx;"></view>
</view>
