.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

.user-section {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  padding: 48rpx 32rpx 40rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-text {
  font-size: 44rpx;
  font-weight: 600;
  color: white;
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: white;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.checkin-btn {
  background-color: rgba(255, 255, 255, 0.95);
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.checkin-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #4CAF50;
}

.stats-section {
  display: flex;
  justify-content: space-around;
  background-color: rgba(255, 255, 255, 0.12);
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-top: 8rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: white;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 8rpx;
}

.vip-section {
  margin: 24rpx 32rpx;
  background: linear-gradient(90deg, #FFF8E1 0%, #FFECB3 100%);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid rgba(255, 193, 7, 0.3);
}

.vip-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.vip-icon {
  font-size: 44rpx;
}

.vip-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #F57C00;
}

.vip-desc {
  font-size: 24rpx;
  color: #FF9800;
  margin-left: 8rpx;
}

.arrow {
  font-size: 36rpx;
  color: #FFB74D;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin: 0 32rpx 20rpx;
  background-color: white;
  border-radius: 20rpx;
  padding: 32rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.menu-grid .menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  position: relative;
}

.menu-grid .menu-icon {
  font-size: 44rpx;
}

.menu-grid .menu-text {
  font-size: 24rpx;
  color: #555;
}

.badge {
  position: absolute;
  top: 8rpx;
  right: 16rpx;
  font-size: 24rpx;
  color: #F44336;
}

.card {
  margin: 0 32rpx 20rpx;
  background-color: white;
  border-radius: 20rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card .menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  position: relative;
}

.card .menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.card .menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #444;
}

.risk-level {
  font-size: 24rpx;
  color: #FF9800;
  margin-right: 8rpx;
  background-color: #FFF3E0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.menu-divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin-left: 60rpx;
}