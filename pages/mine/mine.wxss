.container {
  padding: 16px;
  padding-bottom: 100px;
}

/* 个人信息样式 */
.user-info {
  display: flex;
  align-items: center;
  padding: 16px;
}

.avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background-color: #1E88E5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16px;
}

.avatar-text {
  font-size: 24px;
  font-weight: 600;
  color: #fff;
}

.user-details {
  flex: 1;
}

.user-name {
  font-size: 18px;
  font-weight: 600;
  color: #333;
  margin-bottom: 4px;
  display: block;
}

.user-id {
  font-size: 14px;
  color: #999;
}

.login-btn {
  padding: 8px 16px;
  border-radius: 4px;
  border: 1px solid #1E88E5;
}

.login-btn-text {
  font-size: 14px;
  color: #1E88E5;
}

/* 卡片头部样式 */
.card-header {
  padding: 12px 16px;
  border-bottom: 1px solid #f0f0f0;
}

/* 菜单列表样式 */
.menu-list {
  margin-top: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 20px;
  margin-right: 12px;
}

.menu-text {
  flex: 1;
  font-size: 14px;
  color: #333;
}

.menu-arrow {
  font-size: 16px;
  color: #999;
}

.menu-value {
  font-size: 14px;
  color: #999;
  margin-right: 8px;
}

/* 开关样式 */
switch {
  transform: scale(0.8);
}