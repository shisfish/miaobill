/* ========== 我的页 ========== */
.container { background-color: #F5F5F5; min-height: 100vh; }

/* ---- 用户头部（黄色） ---- */
.user-header {
  background-color: #FFD54F;
  padding: 40rpx 32rpx 36rpx;
}
.user-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}
.avatar-img,
.avatar-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.avatar-char {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFD54F;
}
.nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: #222222;
  margin-left: 20rpx;
  flex: 1;
}
.checkin-btn {
  border: none;
  background-color: rgba(255,255,255,0.9);
  border-radius: 24rpx;
  padding: 10rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #222;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}
.ci-icon { font-size: 24rpx; }

/* 统计行 */
.stat-row {
  display: flex;
}
.st-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
}
.st-val { font-size: 38rpx; font-weight: 800; color: #222222; }
.st-lbl { font-size: 22rpx; color: rgba(0,0,0,0.55); margin-top: 4rpx; }

/* ---- VIP卡片 ---- */
.vip-card {
  margin: 20rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.vip-left { display: flex; align-items: center; gap: 16rpx; }
.vip-icon { font-size: 40rpx; }
.vip-title { font-size: 30rpx; font-weight: 700; color: #333; display: block; }
.vip-desc { font-size: 24rpx; color: #999; }
.arrow { font-size: 36rpx; color: #CCC; }

/* ---- 功能网格 ---- */
.fn-grid {
  margin: 0 24rpx 20rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 28rpx 12rpx;
}
.fn-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
}
.fn-icon { font-size: 42rpx; }
.fn-text { font-size: 24rpx; color: #666; }
.red-dot {
  position: absolute; top: 4rpx; right: 16rpx;
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background-color: #FF4D4F;
}

/* ---- 菜单列表 ---- */
.menu-list {
  margin: 0 24rpx 16rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}
.mi {
  display: flex; align-items: center;
  padding: 28rpx 32rpx;
}
.mi:active { background-color: #FAFAFA; }
.mi-icon { font-size: 36rpx; margin-right: 20rpx; }
.mi { font-size: 30rpx; color: #333; font-weight: 500; flex: 1; }
.arr { color: #CCC; font-size: 34rpx; font-weight: 300; }
.risk { font-size: 24rpx; color: #FF4D4F; margin-right: 12rpx; background:#FFF1F0;padding:4rpx 12rpx;border-radius:8rpx; }
.mi-divider { height: 1rpx; background-color: #F5F5F5; margin-left: 88rpx; }