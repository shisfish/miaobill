.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

.time-filter {
  display: flex;
  background-color: white;
  padding: 16rpx 32rpx;
  gap: 16rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.filter-item.active {
  background-color: #4CAF50;
  color: white;
  font-weight: bold;
}

.month-summary {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background-color: white;
  margin: 20rpx 32rpx;
  padding: 32rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.summary-label {
  font-size: 24rpx;
  color: #999;
}

.summary-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.summary-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: #f0f0f0;
}

.record-list {
  padding: 0 32rpx;
}

.date-group {
  margin-bottom: 20rpx;
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.date-text {
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}

.date-balance {
  font-size: 24rpx;
  color: #666;
}

.date-records {
  background-color: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.category-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.category-icon-wrapper.income {
  background-color: #e8f5e9;
}

.category-icon-wrapper.expense {
  background-color: #ffebee;
}

.category-icon {
  font-size: 40rpx;
}

.record-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.record-category {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.record-remark {
  font-size: 24rpx;
  color: #999;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.record-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.record-time {
  font-size: 22rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}