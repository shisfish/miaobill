/* ========== 明细页 ========== */
.container {
  background-color: #F5F5F5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ---- 黄色顶栏 ---- */
.header {
  background-color: #FFD54F;
  padding: 30rpx 40rpx 40rpx;
}

.header-content {
  display: flex;
  align-items: flex-end;
}

.month-block {
  display: flex;
  flex-direction: column;
}

.header-year {
  font-size: 20rpx;
  color: rgba(0,0,0,0.5);
  margin-bottom: 2rpx;
  display: block;
}

.month-picker {
  display: flex;
  align-items: baseline;
  margin-left: -4rpx;
}

.month-num {
  font-size: 80rpx;
  font-weight: 500;
  color: #222222;
  line-height: 1;
}

.month-label {
  font-size: 26rpx;
  color: #222222;
  margin-left: 2rpx;
  font-weight: 500;
}

.arrow-down {
  font-size: 16rpx;
  color: #222222;
  margin-left: 10rpx;
}

.header-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: rgba(0,0,0,0.1);
  margin: 0 40rpx 10rpx;
}

.stats-block {
  flex: 1;
  display: flex;
  gap: 80rpx;
  margin-bottom: 8rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-lbl {
  font-size: 22rpx;
  color: rgba(0,0,0,0.5);
  margin-bottom: 12rpx;
}

.stat-val {
  font-size: 36rpx;
  color: #222222;
  font-weight: 400;
  line-height: 1;
}

.stat-val.large {
  font-size: 40rpx;
  font-weight: 400;
}

/* ---- 日期分组头 ---- */
.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 32rpx;
  background-color: #FAFAFA;
  border-bottom: 1rpx solid #F0F0F0;
}

.date-text {
  font-size: 24rpx;
  color: #999999;
}

.date-total {
  font-size: 24rpx;
  color: #999999;
}

/* ---- 记录项 ---- */
.record-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F5F5F5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-cat {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
  color: #333333;
}

.record-amt {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

/* ---- 选择器弹窗 ---- */
.picker-panel {
  background-color: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
}

.picker-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #E8E8E8;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
}

.picker-cancel,
.picker-ok {
  font-size: 28rpx;
  color: #888888;
}
.picker-ok { color: #FFD54F; font-weight: 600; }

.picker-body { padding: 20rpx 0; }
.pv { height: 420rpx; }
.pi { line-height: 84rpx; text-align: center; font-size: 34rpx; color: #333; }