page {
  background: #f3f5f8;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff7df 0%, #f3f5f8 22%, #f3f5f8 100%);
  display: flex;
  flex-direction: column;
}

.header {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffcf4a 0%, #ffe7a7 100%);
  box-shadow: 0 14rpx 40rpx rgba(34, 40, 49, 0.08);
}

.header-content {
  display: flex;
  align-items: flex-end;
}

.month-block {
  display: flex;
  flex-direction: column;
}

.header-year {
  font-size: 22rpx;
  color: rgba(31, 31, 31, 0.68);
  margin-bottom: 2rpx;
  display: block;
}

.month-picker {
  display: flex;
  align-items: baseline;
  margin-left: -4rpx;
}

.month-num {
  font-size: 80rpx;
  font-weight: 800;
  color: #1f1f1f;
  line-height: 1;
}

.month-label {
  font-size: 26rpx;
  color: #1f1f1f;
  margin-left: 2rpx;
  font-weight: 600;
}

.arrow-down {
  font-size: 16rpx;
  color: #1f1f1f;
  margin-left: 10rpx;
}

.header-divider {
  width: 1rpx;
  height: 56rpx;
  background-color: rgba(31, 31, 31, 0.12);
  margin: 0 34rpx 10rpx;
}

.stats-block {
  flex: 1;
  display: flex;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-lbl {
  font-size: 22rpx;
  color: rgba(31, 31, 31, 0.68);
  margin-bottom: 12rpx;
}

.stat-val {
  font-size: 36rpx;
  color: #1f1f1f;
  font-weight: 700;
  line-height: 1;
}

.stat-val.large {
  font-size: 40rpx;
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 24rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 22rpx 22rpx 0 0;
  background: #ffffff;
  border-bottom: 1rpx solid #eef1f5;
  box-shadow: 0 8rpx 24rpx rgba(34, 40, 49, 0.05);
}

.date-text,
.date-total {
  font-size: 24rpx;
  color: #667085;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx 22rpx;
  margin: 0 24rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #f3f5f8;
}

.record-item:last-child {
  border-bottom: none;
  border-radius: 0 0 22rpx 22rpx;
}

.record-cat {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
  color: #1f1f1f;
  font-weight: 600;
}

.record-amt {
  font-size: 30rpx;
  color: #1f1f1f;
  font-weight: 700;
}

.picker-panel {
  background-color: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
}

.picker-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #E8E8E8;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.picker-cancel,
.picker-ok {
  font-size: 28rpx;
  color: #667085;
}

.picker-ok {
  color: #1f1f1f;
  font-weight: 700;
}

.picker-body {
  padding: 20rpx 0;
}

.pv {
  height: 420rpx;
}

.pi {
  line-height: 84rpx;
  text-align: center;
  font-size: 34rpx;
  color: #1f1f1f;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.42);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}
