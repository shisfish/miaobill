<view class="container">
  <view class="header">
    <view class="header-content">
      <view class="month-block">
        <text class="header-year">{{currentYear}}年</text>
        <view class="month-picker" bindtap="showMonthPicker">
          <text class="month-num">{{currentMonth < 10 ? '0' + currentMonth : currentMonth}}</text>
          <text class="month-label">月</text>
          <text class="arrow-down">▼</text>
        </view>
      </view>
      <view class="header-divider"></view>
      <view class="stats-block">
        <view class="stat-item">
          <text class="stat-lbl">支出</text>
          <text class="stat-val large">{{monthExpense || '0.00'}}</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y style="flex:1;">
    <block wx:for="{{groupedRecords}}" wx:key="date">
      <view class="date-header">
        <text class="date-text">{{item.dateText}}</text>
        <text class="date-total">支出: {{item.dayExpense}}</text>
      </view>

      <view wx:for="{{item.records}}" wx:for-item="record" wx:key="id" class="record-item" bindtap="viewRecord" data-id="{{record.id}}">
        <view class="icon-circle icon-circle-yellow">
          <text>{{record.categoryIcon}}</text>
        </view>
        <text class="record-cat">{{record.category}}</text>
        <text class="record-amt">{{record.amount}}</text>
      </view>
    </block>

    <view wx:if="{{groupedRecords.length === 0}}" class="empty-state">
      <text class="icon">📝</text>
      <text class="title">暂无记录</text>
      <text class="desc">点击下方「记账」开始记账吧</text>
    </view>

    <view style="height:200rpx;"></view>
  </scroll-view>

  <!-- 悬浮记账按钮 -->
  <view class="fab" bindtap="addRecord">
    <view class="fab-circle">
      <text class="fab-icon">+</text>
    </view>
  </view>

  <view wx:if="{{showMonthPicker}}" class="mask" bindtap="hideMonthPicker">
    <view class="picker-panel" catchtap="stopPropagation">
      <view class="picker-head">
        <text class="picker-cancel" bindtap="hideMonthPicker">取消</text>
        <text class="picker-title">选择月份</text>
        <text class="picker-ok" bindtap="confirmMonth">确定</text>
      </view>
      <view class="picker-body">
        <picker-view class="pv" value="{{pickerValue}}" bindchange="onPickerChange">
          <picker-view-column>
            <view wx:for="{{years}}" wx:key="*this" class="pi">{{item}}</view>
          </picker-view-column>
          <picker-view-column>
            <view wx:for="{{months}}" wx:key="*this" class="pi">{{item < 10 ? '0' + item : item}}</view>
          </picker-view-column>
        </picker-view>
      </view>
    </view>
  </view>
</view>
