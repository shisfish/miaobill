<view class="container">
  <!-- 时间选择器 -->
  <view class="time-selector">
    <picker mode="month" value="{{selectedMonth}}" bindchange="onMonthChange">
      <view class="picker">
        {{selectedMonth}} 统计
      </view>
    </picker>
  </view>
  
  <!-- 收支概览 -->
  <view class="card">
    <view class="overview">
      <view class="overview-item">
        <text class="overview-label">收入</text>
        <text class="overview-amount income">¥{{monthIncome}}</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">支出</text>
        <text class="overview-amount expense">¥{{monthExpense}}</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">结余</text>
        <text class="overview-amount {{balance >= 0 ? 'income' : 'expense'}}">
          {{balance >= 0 ? '+' : ''}}¥{{Math.abs(balance)}}
        </text>
      </view>
    </view>
  </view>
  
  <!-- 分类占比 -->
  <view class="card">
    <view class="card-header">
      <text class="subtitle">分类占比</text>
      <view class="type-switch">
        <text 
          class="switch-item {{activeType === 1 ? 'active' : ''}}" 
          bindtap="switchType" 
          data-type="1"
        >
          收入
        </text>
        <text 
          class="switch-item {{activeType === 2 ? 'active' : ''}}" 
          bindtap="switchType" 
          data-type="2"
        >
          支出
        </text>
      </view>
    </view>
    <view class="chart-container">
      <!-- 这里将使用ECharts绘制饼图 -->
      <canvas canvas-id="pieChart" class="chart"></canvas>
    </view>
  </view>
  
  <!-- 分类明细 -->
  <view class="card">
    <view class="card-header">
      <text class="subtitle">分类明细</text>
    </view>
    <view class="category-details">
      <block wx:for="{{categoryDetails}}" wx:key="category">
        <view class="list-item">
          <view class="category-info">
            <text class="category-icon">{{getCategoryIcon(item.category)}}</text>
            <text class="category-name">{{item.category}}</text>
          </view>
          <view class="category-amount">
            <text class="{{activeType === 1 ? 'income' : 'expense'}}">
              {{activeType === 1 ? '+' : '-'}}¥{{item.amount}}
            </text>
            <text class="percentage">{{item.percentage}}%</text>
          </view>
        </view>
      </block>
      <view wx:if="{{categoryDetails.length === 0}}" class="empty-details">
        <text class="text">暂无数据</text>
      </view>
    </view>
  </view>
</view>