/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #f8f9fa;
  color: #333;
  -webkit-font-smoothing: antialiased;
}

/* 主题颜色 */
:root {
  --primary-color: #4CAF50;
  --accent-color: #66BB6A;
  --text-color: #333;
  --text-secondary: #666;
  --text-tertiary: #999;
  --background-color: #f8f9fa;
  --card-background: #fff;
  --border-color: #f0f0f0;
  --income-color: #4CAF50;
  --expense-color: #F44336;
}

/* 卡片样式 */
.card {
  background-color: var(--card-background);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 按钮样式 */
.btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  cursor: pointer;
}

.btn-primary {
  background-color: var(--primary-color);
  color: #fff;
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #333;
  border: 1rpx solid #ddd;
}

/* 输入框样式 */
.input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
}

/* 标题样式 */
.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
  color: var(--text-color);
}

/* 副标题样式 */
.subtitle {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
  color: var(--text-color);
}

/* 文本样式 */
.text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 收入样式 */
.income {
  color: var(--income-color);
}

/* 支出样式 */
.expense {
  color: var(--expense-color);
}

/* 图标样式 */
.icon {
  width: 48rpx;
  height: 48rpx;
  vertical-align: middle;
}

/* 列表项样式 */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

/* 底部记账按钮 */
.add-btn {
  position: fixed;
  bottom: 140rpx;
  right: 40rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.2);
  font-size: 48rpx;
  z-index: 999;
}

/* 导航栏样式 */
.nav-bar {
  height: 88rpx;
  background-color: var(--primary-color);
  color: #fff;
  padding: 0 32rpx;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 切换按钮样式 */
.toggle-btn {
  display: flex;
  background-color: #f0f0f0;
  border-radius: 12rpx;
  padding: 4rpx;
  gap: 4rpx;
  margin: 32rpx 0;
}

.toggle-btn-item {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  background-color: transparent;
  color: #666;
  border-radius: 8rpx;
}

.toggle-btn-item.active {
  background-color: var(--primary-color);
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.3);
}

/* 统计卡片样式 */
.stat-card {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
  color: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin: 32rpx;
  text-align: center;
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.25);
}

.stat-card-large {
  font-size: 56rpx;
  font-weight: 600;
  margin: 20rpx 0;
}

.stat-card-small {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 表格样式 */
.table {
  width: 100%;
  border-collapse: collapse;
}

.table th {
  background-color: #f5f5f5;
  padding: 24rpx;
  text-align: left;
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  border-bottom: 1rpx solid #e0e0e0;
}

.table td {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 预算环形图 */
.budget-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 16rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.budget-circle .progress {
  position: absolute;
  top: -16rpx;
  left: -16rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 16rpx solid transparent;
  border-top: 16rpx solid var(--primary-color);
  transform: rotate(0deg);
  transition: transform 0.5s ease;
}

/* 记账页面样式 */
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  padding: 32rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f5f5f5, #eeeeee);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  font-size: 44rpx;
}

.category-icon.active {
  background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.category-name {
  font-size: 24rpx;
  color: #666;
}

/* 数字键盘 */
.num-keyboard {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rpx;
  background-color: #e0e0e0;
  padding: 2rpx;
}

.key {
  background-color: #fff;
  padding: 40rpx 0;
  text-align: center;
  font-size: 40rpx;
  font-weight: 500;
}

.key.equal {
  grid-row: span 2;
  background-color: var(--primary-color);
  color: #fff;
  font-size: 48rpx;
}

/* 底部导航栏 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-around;
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 24rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #999;
}

.tab-item.active .tab-text {
  color: var(--primary-color);
  font-weight: 500;
}