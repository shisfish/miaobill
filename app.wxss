/* ========== 全局样式 - 杪记风格 ========== */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  background-color: #F5F5F5;
  color: #333333;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

/* ======== 主题色变量 ======== */
page {
  /* 主色调 - 黄色 */
  --yellow: #FFD54F;
  --yellow-dark: #FFC107;
  --yellow-light: #FFF176;

  /* 文字颜色 */
  --text-black: #222222;
  --text-gray: #888888;
  --text-light: #BBBBBB;
  --text-white: #FFFFFF;

  /* 背景 */
  --bg-page: #F5F5F5;
  --bg-white: #FFFFFF;
  --bg-gray: #EEEEEE;

  /* 边框 */
  --border-color: #E8E8E8;
  --divider-color: #F0F0F0;

  /* 功能色 */
  --color-red: #FF4D4F;
  --color-green: #52C41A;
}

/* ========== 卡片 ========== */
.card {
  background-color: var(--bg-white);
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  overflow: hidden;
}

/* ========== 按钮 ========== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-yellow {
  background-color: var(--yellow);
  color: var(--text-black);
}

/* ========== 输入框 ========== */
.input {
  width: 100%;
  padding: 20rpx;
  border: none;
  font-size: 28rpx;
  background: transparent;
  color: var(--text-black);
}

/* ========== 列表项 ========== */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-white);
  border-bottom: 1rpx solid var(--divider-color);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background-color: #FAFAFA;
}

/* ========== 图标圆圈（分类图标背景）========== */
.icon-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  font-size: 36rpx;
}

.icon-circle-yellow {
  background-color: #FFF8E1;
}

.icon-circle-selected {
  background-color: var(--yellow);
}

/* ========== 文字工具类 ========== */
.text-black { color: var(--text-black); }
.text-gray { color: var(--text-gray); }
.text-light { color: var(--text-light); }
.text-red { color: var(--color-red); }
.text-green { color: var(--color-green); }

.font-bold { font-weight: 700; }
.font-medium { font-weight: 500; }

/* ========== 分割线 ========== */
.divider {
  height: 1rpx;
  background-color: var(--divider-color);
  margin-left: 112rpx; /* 缩进图标+间距宽度 */
}

/* ========== 浮动按钮(+) ========== */
.fab {
  position: fixed;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: var(--yellow);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  box-shadow: 0 4rpx 16rpx rgba(255, 213, 79, 0.4);
}

.fab-icon {
  font-size: 56rpx;
  color: var(--text-black);
  font-weight: 300;
}

/* ========== 弹窗遮罩 ========== */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
}
.empty-state .icon { font-size: 96rpx; opacity: 0.25; margin-bottom: 24rpx; }
.empty-state .title { font-size: 30rpx; color: var(--text-gray); margin-bottom: 12rpx; }
.empty-state .desc { font-size: 26rpx; color: var(--text-light); }

/* ========== 进度条 ========== */
.progress-bar {
  height: 10rpx;
  background-color: var(--bg-gray);
  border-radius: 5rpx;
  overflow: hidden;
  flex: 1;
}
.progress-fill {
  height: 100%;
  background-color: var(--yellow);
  border-radius: 5rpx;
}